rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function adminDoc() { return /databases/$(database)/documents/app/admin; }
    function isAdmin() { return signedIn() && exists(adminDoc()) && get(adminDoc()).data.uid == request.auth.uid; }
    function isAllowed() {
      return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/allowed/$(request.auth.token.email.lower())));
    }

    // המשתמש הראשון שמתחבר נרשם כמנהל. אחרי זה אי אפשר לשנות מהאפליקציה
    match /app/admin {
      allow read: if signedIn();
      allow create: if signedIn() && !exists(adminDoc()) && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /app/config {
      allow read: if isAllowed();
      allow write: if isAdmin();
    }
    match /pricelists/{supplierId} {
      allow read: if isAllowed();
      allow write: if isAdmin();
    }
    match /allowed/{email} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email.lower() == email);
      allow write: if isAdmin();
    }
  }
}
